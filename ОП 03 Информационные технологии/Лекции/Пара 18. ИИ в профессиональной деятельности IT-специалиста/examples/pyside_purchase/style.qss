QWidget {
    font-family: "Segoe UI", "Arial";
    font-size: 14px;
    color: #243047;
}
PurchaseWindow { background: #f0f4fa; }
QLabel#brand { color: #5268db; font-size: 12px; font-weight: bold; }
QLabel#title { font-size: 32px; font-weight: bold; color: #17243b; }
QLabel#subtitle, QLabel#note { color: #6b7890; }
QLabel#note { font-size: 12px; }
QFrame#card { background: white; border: 1px solid #dfe6f1; border-radius: 18px; }
QLineEdit, QComboBox, QSpinBox, QTextEdit {
    background: #f8faff;
    border: 1px solid #ccd6e6;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: #5268db;
    selection-color: white;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #5268db;
    background: white;
}
QComboBox QAbstractItemView { background: white; selection-background-color: #e5eaff; }
QLabel#total { color: #4056c6; font-size: 24px; font-weight: bold; }
QPushButton {
    background: #5268db;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: bold;
}
QPushButton:hover { background: #4056c6; }
QPushButton:pressed { background: #3245a6; }
QPushButton:focus { border: 2px solid #aab7ff; }
QLabel#status { color: #6b7890; }
